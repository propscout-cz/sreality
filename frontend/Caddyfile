{
	# Railway terminates TLS at its edge; the app speaks plain HTTP.
	auto_https off
	admin off
}

:{$PORT:80} {
	root * /srv
	encode gzip zstd

	# The retired Railway address forwards to the brand domain, path and query
	# kept, until both old addresses are removed (brand-domain PROGRAM.md W1).
	# Railway's healthcheck arrives as healthcheck.railway.app, so it is untouched.
	@retired_host host sreality-production-1bb6.up.railway.app
	redir @retired_host https://app.propscout.cz{uri} 301

	# Liveness endpoint Railway hits per railway.json healthcheckPath.
	# Exclusive handle block — no fall-through to try_files/file_server.
	handle /healthz {
		respond "ok" 200
	}

	# Hashed bundles in /assets/ are immutable; long-cache them and
	# serve directly without SPA fallback.
	handle_path /assets/* {
		root * /srv/assets
		# The immutable header must ride on a REAL FILE only. A tab that
		# outlived a deploy asks for a chunk filename this container no longer
		# has; stamping that 404 with max-age=31536000 (which is what an
		# unmatched `header` directive did) tells the browser to remember the
		# miss for a year, turning a recoverable staleness event into a
		# permanent one for that URL.
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The installable shell's own files: a real file or a real 404, never the
	# SPA fallback below. A missing /sw.js answered 200 text/html fails
	# registration, and an installed worker whose script fails its update
	# check stays installed — so these must never reach try_files. Each
	# handle block is exclusive; single-path blocks sort before the
	# matcher-less catch-all, the named @icons one keeps its place above it,
	# and file_server's 404 goes through handle_errors (no-store). Content
	# types are explicit because the caddy:2-alpine tag floats and
	# file_server sends none for an extension its MIME table lacks.
	#
	# The service worker: no-cache (the browser already skips its HTTP cache
	# for this script; proxies must too). Never delete public/sw.js — retire
	# it with the self-unregistering version described in its header.
	handle /sw.js {
		header Cache-Control "no-cache"
		header Content-Type "text/javascript; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# The web app manifest: iOS reads it once, at install.
	handle /manifest.webmanifest {
		header Cache-Control "no-cache"
		header Content-Type "application/manifest+json"
		file_server
	}

	# Home-screen and tab icons; Safari probes the two apple-touch names on
	# its own, so the one we do not ship answers 404, not the shell.
	@icons path /icons/* /apple-touch-icon.png /apple-touch-icon-precomposed.png /favicon.ico
	handle @icons {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else: SPA fallback to /index.html, no aggressive cache.
	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "strict-origin-when-cross-origin"
		header X-Frame-Options "DENY"
		header -Server

		try_files {path} /index.html
		file_server
	}

	# No error response is ever cacheable. Without this a 404 has no
	# Cache-Control at all and is heuristically cacheable by the browser.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
