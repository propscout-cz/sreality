# Copy to .env for local development. NEVER commit the real .env file.
# In production these are GitHub Actions secrets, not a file.

# Supabase project URL, e.g. https://erlvtprrmrylhznfyaih.supabase.co
SUPABASE_URL=

# Supabase service-role secret. New 2025 format starting with sb_secret_...
# This is NOT a JWT. Kept for forward compatibility; the v1 scraper does
# not need it because we connect to Postgres directly via SUPABASE_DB_URL.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string from Supabase project.
# Project Settings -> Database -> Connection string -> Transaction pooler.
# Format: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
SUPABASE_DB_URL=

# Cloudflare R2 credentials for image storage. If any of these are
# missing the image-download phase becomes a no-op (the scraper still
# records image URLs in the images table; it just doesn't download).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: override scrape country. The category list (byt/dum/komercni
# × pronajem/prodej) is hardcoded in scraper.main.CATEGORIES — it is no
# longer env-driven.
# SREALITY_COUNTRY_ID=10001    # 10001 = Czech Republic

# The FastAPI service accepts one credential: a Supabase JWT (verified against
# SUPABASE_URL's JWKS). Local development without a signed-in caller opts out
# with API_AUTH_OPTIONAL=1 — never set it on Railway.
# API_AUTH_OPTIONAL=1

# Anthropic API key. Required by the FastAPI service for LLM-driven
# parsing of non-sreality listing URLs (bezrealitky / idnes-reality /
# remax / unsupported sources). Backend-only; never expose to the
# browser. Every call is logged to the llm_calls table with token
# counts and USD cost.
ANTHROPIC_API_KEY=

# Alibaba DashScope key (the INTERNATIONAL / Singapore endpoint). Read
# lazily, so it is needed only by a lane whose model id starts with
# `qwen` — today the W2-10 location bake-off
# (scripts/location_llm_bakeoff.py) and the free-text claims lane if the
# operator selects a qwen model. Backend-only; add it as a GitHub Actions
# secret for those two workflows.
QWEN_API_KEY=

# Mapy.cz REST API key. Used by the URL parser to geocode locality
# strings extracted from non-sreality listings (those sources rarely
# include coordinates on the page). Backend-only.
MAPY_CZ_API_KEY=
# Optional backup Mapy.cz key. Used automatically only when the primary key
# is rejected (401/403) or rate-limited (429) — see scraper/geocoding.py.
MAPY2_CZ_API_KEY=

# Valuo's paid valuation API (api/valuo_client.py). These live on the Railway API service only:
# leave both empty here. The name is the environment and production wins when both are set, so a
# production token in a local .env would spend paid calls from local work.
VALUO_SANDBOX_API_TOKEN=
VALUO_API_TOKEN=

# Stripe webhook signing secret (Dashboard -> Developers -> Webhooks). Backend-only;
# unset means POST /billing/webhook answers 503 (fail closed).
STRIPE_WEBHOOK_SECRET=

# Dedicated Supabase Auth logins reserved for autonomous production smoke-checks
# (real-browser verification after a frontend deploy) — not real operator accounts.
# Admin has a public.admins row + app_metadata.is_admin=true; non-admin has neither.
# See memory: railway-deploy-status-via-gh-commit-status / prod-smoke-check-accounts.
SMOKE_TEST_ADMIN_EMAIL=
SMOKE_TEST_ADMIN_PASSWORD=
SMOKE_TEST_NONADMIN_EMAIL=
SMOKE_TEST_NONADMIN_PASSWORD=
