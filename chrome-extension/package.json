{
  "name": "sreality-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode content && vite build --mode background && vite build --mode sidepanel",
    "watch": "vite build --watch --mode",
    "type-check": "tsc --noEmit",
    "test": "node --test src/*.test.ts release/*.test.ts",
    "package": "node release/make_store_package.ts dist store",
    "e2e": "node e2e/sidepanel.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
